            "exec": [
              "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Responde JSON', () => pm.response.to.be.json);",
              "const j = pm.response.json();",
              "pm.test('status del cuerpo = 404', () => pm.expect(j.status).to.eql(404));",
              "pm.test('Incluye mensaje', () => pm.expect(j).to.have.property('mensaje'));",
              "pm.test('Incluye path', () => pm.expect(j).to.have.property('path'));"
            ]
          }
        }
