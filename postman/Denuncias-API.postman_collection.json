              "pm.test('Arreglo vacio', () => { pm.expect(arr).to.be.an('array'); pm.expect(arr).to.have.lengthOf(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/denuncias/ciudadano/00000000"
      }
